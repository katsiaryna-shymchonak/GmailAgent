{
  "manifest_version": 3,
  "name": "Gmail Reader",
  "version": "1.0",
  "description": "Analyses messages from Gmail",
  "permissions": ["identity", "storage"],
  "action": {
    "default_popup": "client/popup.html"
  },
  "background": {
    "service_worker": "client/background.js",
    "type": "module"
  },
  "oauth2": {
    "client_id": "739930632604-1nr2siomor130m0a2bg2uc7carvcdvq0.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  }
}

